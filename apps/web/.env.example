# Copy to .env.local (never commit it) and fill in every value. The app refuses to start
# if any value is missing, too short, low-entropy, or shared with another secret.
#
# Generate the secrets below with:   pnpm secrets:generate
# Local database:                    pnpm db:up   (see infra/dev-db/compose.yaml)

# --- public (inlined into the browser bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where this app is served, no path. Requests that change anything must come from this origin, and
# the session cookie is marked Secure (and gets the __Host- prefix) when it is https.
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- server only ---
# The shop app logs in as the limited role `retail_app` (PLAN.md D26), NEVER as the owner.
# Local example:  postgresql://retail_app:<APP_DB_PASSWORD>@127.0.0.1:54322/postgres
# Enable that login once with:  APP_DB_PASSWORD=... DATABASE_ADMIN_URL=... pnpm db:migrate
# (DATABASE_ADMIN_URL, the owner login, is for migrations and scripts only. Do not put it here.)
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Verifies login tokens signed with the project's shared secret (HS256: local Supabase and older
# cloud projects). LEAVE EMPTY for projects that sign with asymmetric keys: the public keys are then
# fetched from <project url>/auth/v1/.well-known/jwks.json. When set it must be a strong secret of its own.
SUPABASE_JWT_SECRET=

# Each must be a different random value of at least 32 characters.
SESSION_SECRET=
PIN_PEPPER=
DEVICE_TOKEN_PEPPER=
REFERENCE_PEPPER=

# --- local development only ---
# Lets you enter the app as the demo shop's owner on your own computer (after `pnpm dev:seed`).
# A production build REFUSES to start if this is set at all, so it cannot reach a live server.
# ALLOW_DEV_SIGN_IN=1
