# Copy to .env.local (never commit it) and fill in every value. The app refuses to start
# if any value is missing, too short, low-entropy, or shared with another secret.
#
# Generate the four secrets below with:   pnpm secrets:generate
# Supabase values come from:              supabase status   (after `supabase start`)

# --- public (inlined into the browser bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- server only ---
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Each must be a different random value of at least 32 characters.
SESSION_SECRET=
PIN_PEPPER=
DEVICE_TOKEN_PEPPER=
REFERENCE_PEPPER=
