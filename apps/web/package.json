{
  "name": "@retail/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @retail/i18n generate && next dev",
    "build": "pnpm --filter @retail/i18n generate && next build",
    "start": "next start",
    "cf:build": "pnpm --filter @retail/i18n generate && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "pnpm --filter @retail/i18n generate && next build && playwright test"
  },
  "dependencies": {
    "@retail/core": "workspace:*",
    "@retail/db": "workspace:*",
    "@retail/i18n": "workspace:*",
    "@retail/ui": "workspace:*",
    "jose": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@retail/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
