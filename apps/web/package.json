{
  "name": "@retail/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate --workspace=@retail/i18n && next dev -p 3000 -H 0.0.0.0",
    "build": "npm run generate --workspace=@retail/i18n && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "cf:build": "npm run generate --workspace=@retail/i18n && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "npm run generate --workspace=@retail/i18n && next build && playwright test"
  },
  "dependencies": {
    "@retail/core": "*",
    "@retail/db": "*",
    "@retail/i18n": "*",
    "@retail/ui": "*",
    "jose": "6.2.12",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "1.64.1",
    "@retail/config": "*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
