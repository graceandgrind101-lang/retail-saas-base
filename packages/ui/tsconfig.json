{
  "extends": "@retail/config/tsconfig/base.json",
  // Components run in the browser: DOM types and JSX, but NO Node types. Tests and scripts are
  // checked by tsconfig.test.json.
  "compilerOptions": { "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx" },
  "include": ["src", "*.config.*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/testing"]
}
