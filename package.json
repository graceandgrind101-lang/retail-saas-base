{
  "name": "retail-saas",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant retail POS SaaS (brand is config, see PLAN.md D5)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
